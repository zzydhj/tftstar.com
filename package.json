{
    "name": "tftstar-com-static",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "description": "Static mirror of tftstar.com for an independent Cloudflare Pages deployment, built from the site's own backup. Zero runtime dependencies.",
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "mirror": "node tools/mirror.mjs",
        "fonts": "node tools/fetch-fonts.mjs",
        "check": "node tools/check.mjs",
        "verify": "node tools/mirror.mjs && node tools/check.mjs",
        "test": "node --test tools/ingest/wp/staticize.test.mjs tools/ingest/wp/search-index.test.mjs tools/lib/site-links.test.mjs",
        "wp:data": "node tools/ingest/wp/index.mjs",
        "preview": "node tools/serve.mjs"
    }
}